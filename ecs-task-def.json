{
  "family": "fluiq-security",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::383136686684:role/fluiqEcsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "fluiq-security",
      "image": "383136686684.dkr.ecr.us-east-2.amazonaws.com/fluiq-security:latest",
      "essential": true,
      "environment": [
        { "name": "KAFKA_TRACE_PERSISTED_TOPIC", "value": "traces.persisted" },
        { "name": "KAFKA_SECURITY_TOPIC",        "value": "security" },
        { "name": "KAFKA_SECURITY_GROUP_ID",     "value": "security-workers" },
        { "name": "KAFKA_SECURITY_REPLY_TOPIC",  "value": "fluiq.security.reply" },
        { "name": "CLICKHOUSE_SECURITY_TABLE",   "value": "security_scans" }
      ],
      "secrets": [
        { "name": "KAFKA_BOOTSTRAP_SERVERS", "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/KAFKA_BOOTSTRAP_SERVERS" },
        { "name": "KAFKA_SECURITY_PROTOCOL", "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/KAFKA_SECURITY_PROTOCOL" },
        { "name": "KAFKA_SASL_MECHANISM",    "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/KAFKA_SASL_MECHANISM" },
        { "name": "CLICKHOUSE_HOST",         "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/CLICKHOUSE_HOST" },
        { "name": "CLICKHOUSE_PORT",         "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/CLICKHOUSE_PORT" },
        { "name": "CLICKHOUSE_USER",         "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/CLICKHOUSE_USER" },
        { "name": "CLICKHOUSE_PASSWORD",     "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/CLICKHOUSE_PASSWORD" },
        { "name": "CLICKHOUSE_DATABASE",     "valueFrom": "arn:aws:ssm:us-east-2:383136686684:parameter/fluiq/prod/CLICKHOUSE_DATABASE" },
        { "name": "KAFKA_SASL_USERNAME",     "valueFrom": "arn:aws:secretsmanager:us-east-2:383136686684:secret:AmazonMSK_fluiq-d9VRtG:username::" },
        { "name": "KAFKA_SASL_PASSWORD",     "valueFrom": "arn:aws:secretsmanager:us-east-2:383136686684:secret:AmazonMSK_fluiq-d9VRtG:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluiq-security",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
